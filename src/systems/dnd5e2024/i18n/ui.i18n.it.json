    "conditions": {
      "blinded": {
        "name": "Accecato",
        "desc": "Non puoi vedere. Fallisce automaticamente le prove che richiedono la vista. I tiri per colpire contro di te hanno vantaggio; i tuoi tiri per colpire hanno svantaggio."
      },
      "charmed": {
        "name": "Affascinato",
        "desc": "Non puoi attaccare chi ti ha affascinato né bersagliarlo con effetti dannosi. Chi ti ha affascinato ha vantaggio alle prove di interazione sociale."
      },
      "deafened": {
        "name": "Assordato",
        "desc": "Non puoi sentire. Fallisce automaticamente le prove che richiedono l'udito."
      },
      "frightened": {
        "name": "Spaventato",
        "desc": "Svantaggio alle prove di caratteristica e ai tiri per colpire finché la fonte della paura è in vista. Non puoi avvicinarti volontariamente alla fonte."
      },
      "grappled": {
        "name": "Afferrato",
        "desc": "Velocità ridotta a 0. Termina se chi afferra è incapacitato o la creatura viene spostata oltre la sua portata."
      },
      "incapacitated": {
        "name": "Incapacitato",
        "desc": "Non puoi compiere azioni, azioni bonus o reazioni."
      },
      "invisible": {
        "name": "Invisibile",
        "desc": "Non puoi essere visto senza magia. I tiri per colpire contro di te hanno svantaggio; i tuoi attacchi hanno vantaggio."
      },
      "paralyzed": {
        "name": "Paralizzato",
        "desc": "Incapacitato, non puoi muoverti né parlare. Fallisce i TS FOR e DES. I colpi in mischia entro 1,5 m sono critici automatici."
      },
      "petrified": {
        "name": "Pietrificato",
        "desc": "Trasformato in pietra. Incapacitato, resistenza a tutti i danni, immune a veleno e malattie, non invecchia."
      },
      "poisoned": {
        "name": "Avvelenato",
        "desc": "Svantaggio ai tiri per colpire e alle prove di caratteristica."
      },
      "prone": {
        "name": "A Terra",
        "desc": "Puoi solo strisciare. Svantaggio ai tiri per colpire. I colpi in mischia hanno vantaggio; i colpi a distanza hanno svantaggio."
      },
      "restrained": {
        "name": "Trattenuto",
        "desc": "Velocità 0. Svantaggio ai tiri per colpire e ai TS DES. I tiri per colpire contro di te hanno vantaggio."
      },
      "stunned": {
        "name": "Stordito",
        "desc": "Incapacitato, non puoi muoverti, parli solo balbettando. Fallisce i TS FOR e DES. I tiri per colpire contro di te hanno vantaggio."
      },
      "unconscious": {
        "name": "Privo di Sensi",
        "desc": "Incapacitato, non puoi muoverti né parlare. Lascia cadere gli oggetti. Fallisce i TS FOR e DES. I colpi in mischia entro 1,5 m sono critici automatici."
      },
